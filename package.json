{
  "name": "root",
  "private": false,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": "24.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "node scripts/build-talks.mjs && pnpm --filter dotdev build",
    "talks:build": "node scripts/build-talks.mjs",
    "talk:dev": "node scripts/dev-talk.mjs",
    "talk:export": "node scripts/export-talk.mjs",
    "talk:new": "node scripts/new-talk.mjs",
    "start": "turbo run start",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "docker:build": "docker build -t louisescher-dotdev .",
    "docker:start": "docker run -p 4321:4321 louisescher-dotdev"
  },
  "devDependencies": {
  	"@biomejs/biome": "2.3.15",
    "turbo": "^2.3.3"
  }
}
