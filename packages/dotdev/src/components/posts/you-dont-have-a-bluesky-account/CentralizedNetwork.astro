<figure class="centralized" data-state="online">
	<div class="toolbar">
		<span class="toolbar-label">Twitter keeps everything</span>
		<div class="toolbar-actions">
			<span class="legend">
				<svg class="legend-post" viewBox="0 0 22 16" aria-hidden="true">
					<rect width="22" height="16" fill="currentColor" />
					<rect x="4" y="4.5" width="14" height="1.6" fill="#0b0b0b" />
					<rect x="4" y="9.5" width="9" height="1.6" fill="#0b0b0b" />
				</svg>
				Your posts
			</span>
			<button type="button" class="toggle" aria-pressed="false" data-toggle>Shut down Twitter</button>
		</div>
	</div>
	<svg class="diagram" viewBox="0 0 600 405" role="img" aria-labelledby="centralized-title">
		<title id="centralized-title">Alice, Bob, Charlie, and Peter all use Twitter. Every one of their posts is stored on Twitter's servers.</title>
		<defs>
			<symbol id="centralized-person" viewBox="-26 -26 52 52">
				<circle r="25" fill="#0b0b0b" stroke="currentColor" stroke-width="1.5" />
				<circle cy="-6" r="8" fill="none" stroke="currentColor" stroke-width="1.5" />
				<path d="M-14 16 a14 13 0 0 1 28 0" fill="none" stroke="currentColor" stroke-width="1.5" />
			</symbol>
			<symbol id="centralized-post" viewBox="0 0 22 16">
				<rect width="22" height="16" fill="currentColor" />
				<rect x="4" y="4.5" width="14" height="1.6" fill="#0b0b0b" />
				<rect x="4" y="9.5" width="9" height="1.6" fill="#0b0b0b" />
			</symbol>
		</defs>
		<g class="edges">
			<line class="edge" x1="96.5" y1="76.1" x2="195.7" y2="136.5" />
			<line class="edge" x1="503.5" y1="76.1" x2="404.3" y2="136.5" />
			<line class="edge" x1="96.5" y1="323.9" x2="195.7" y2="263.5" />
			<line class="edge" x1="503.5" y1="323.9" x2="404.3" y2="263.5" />
		</g>
		<g class="people">
			<use class="person" href="#centralized-person" x="44" y="34" width="52" height="52" />
			<text class="label" x="70" y="112" text-anchor="middle">Alice</text>
			<use class="person" href="#centralized-person" x="504" y="34" width="52" height="52" />
			<text class="label" x="530" y="112" text-anchor="middle">Bob</text>
			<use class="person" href="#centralized-person" x="44" y="314" width="52" height="52" />
			<text class="label" x="70" y="392" text-anchor="middle">Charlie</text>
			<use class="person" href="#centralized-person" x="504" y="314" width="52" height="52" />
			<text class="label" x="530" y="392" text-anchor="middle">Peter</text>
		</g>
		<g class="server">
			<rect class="server-box" x="200" y="135" width="200" height="130" />
			<svg class="server-logo" x="257" y="150" width="32" height="32" viewBox="0 0 24 24">
				<path fill="currentColor" d="M21.543 7.104c.015.211.015.423.015.636c0 6.507-4.954 14.01-14.01 14.01v-.003A13.94 13.94 0 0 1 0 19.539a9.88 9.88 0 0 0 7.287-2.041a4.93 4.93 0 0 1-4.6-3.42a4.9 4.9 0 0 0 2.223-.084A4.926 4.926 0 0 1 .96 9.167v-.062a4.9 4.9 0 0 0 2.235.616A4.93 4.93 0 0 1 1.67 3.148a13.98 13.98 0 0 0 10.15 5.144a4.929 4.929 0 0 1 8.39-4.49a9.9 9.9 0 0 0 3.128-1.196a4.94 4.94 0 0 1-2.165 2.724A9.8 9.8 0 0 0 24 4.555a10 10 0 0 1-2.457 2.549" />
			</svg>
			<text class="server-name" x="297" y="172">Twitter</text>
			<text class="server-offline" x="300" y="172" text-anchor="middle">gone</text>
			<g class="post-group" style="--i: 0">
				<use class="post" href="#centralized-post" x="223" y="200" width="22" height="16" />
				<text class="post-owner" x="234" y="234" text-anchor="middle">Alice</text>
			</g>
			<g class="post-group" style="--i: 1">
				<use class="post" href="#centralized-post" x="267" y="200" width="22" height="16" />
				<text class="post-owner" x="278" y="234" text-anchor="middle">Bob</text>
			</g>
			<g class="post-group" style="--i: 2">
				<use class="post" href="#centralized-post" x="311" y="200" width="22" height="16" />
				<text class="post-owner" x="322" y="234" text-anchor="middle">Charlie</text>
			</g>
			<g class="post-group" style="--i: 3">
				<use class="post" href="#centralized-post" x="355" y="200" width="22" height="16" />
				<text class="post-owner" x="366" y="234" text-anchor="middle">Peter</text>
			</g>
		</g>
	</svg>
	<figcaption class="status" aria-live="polite">
		<span data-status="online">Everyone's account and posts live on servers that Twitter owns</span>
		<span data-status="offline" hidden>Twitter is gone, and everyone's posts went with it. Nobody can take them to another app now...</span>
	</figcaption>
</figure>

<style>
	.centralized {
		--diagram-line: #353535;
		--diagram-stroke: #c7c7c7;
		--diagram-muted: #6b6b6b;
		--diagram-accent: var(--primary, #8c5cf5);
		margin: 1.5rem 0;
		border: 1px solid var(--diagram-line);
		background-color: #0b0b0b;
		color: #ffffff;
	}

	.toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.625rem 0.75rem;
		border-bottom: 1px solid var(--diagram-line);
	}

	.toolbar-label,
	.legend {
		font-family: "Geist Mono", monospace;
		font-size: 0.8125rem;
		color: var(--diagram-stroke);
	}

	.toolbar-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	.legend {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.legend-post {
		width: 1.125rem;
		height: auto;
		color: var(--diagram-accent);
		filter: drop-shadow(0 0 4px var(--diagram-accent));
	}

	.toggle {
		font-family: "Geist Mono", monospace;
		font-size: 0.8125rem;
		color: #ffffff;
		background-color: transparent;
		border: 1px solid var(--diagram-line);
		padding: 0.375rem 0.75rem;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease;
	}

	.toggle:hover {
		background-color: rgba(140, 92, 245, 0.125);
		border-color: var(--diagram-accent);
	}

	.toggle:focus-visible {
		outline: 2px solid var(--diagram-accent);
		outline-offset: 2px;
	}

	.toggle[aria-pressed="true"] {
		background-color: var(--diagram-accent);
		border-color: var(--diagram-accent);
	}

	.diagram {
		display: block;
		width: 100%;
		height: auto;
		padding: 1rem;
	}

	.edge {
		stroke: var(--diagram-stroke);
		stroke-width: 1.5;
		transition: opacity 0.5s ease;
	}

	.person {
		color: var(--diagram-stroke);
		transition: color 0.5s ease;
	}

	.label {
		font-family: "Geist", sans-serif;
		font-size: 17px;
		fill: #ffffff;
		transition: fill 0.5s ease;
	}

	.server-box {
		fill: #111111;
		stroke: var(--diagram-stroke);
		stroke-width: 1.5;
		transition: stroke 0.5s ease;
	}

	.server-logo {
		color: #1d9bf0;
		transition: opacity 0.4s ease;
	}

	.server-name {
		font-family: "Geist", sans-serif;
		font-size: 15px;
		fill: #ffffff;
		transition: opacity 0.4s ease;
	}

	.server-offline {
		font-family: "Geist Mono", monospace;
		font-size: 15px;
		fill: var(--diagram-muted);
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.post-group {
		transition:
			transform 0.6s cubic-bezier(0.55, 0, 1, 0.45) calc(var(--i) * 80ms),
			opacity 0.6s ease calc(var(--i) * 80ms);
	}

	.post {
		color: var(--diagram-accent);
		filter: drop-shadow(0 0 4px var(--diagram-accent));
	}

	.post-owner {
		font-family: "Geist", sans-serif;
		font-size: 11px;
		fill: var(--diagram-stroke);
	}

	.status {
		padding: 0.625rem 0.75rem;
		border-top: 1px solid var(--diagram-line);
		font-size: 0.875rem;
		color: var(--diagram-stroke);
		min-height: 3.25rem;
	}

	[data-state="offline"] .edge {
		opacity: 0.12;
	}

	[data-state="offline"] .person {
		color: var(--diagram-muted);
	}

	[data-state="offline"] .label {
		fill: var(--diagram-muted);
	}

	[data-state="offline"] .server-box {
		stroke: var(--diagram-muted);
		stroke-dasharray: 6 6;
	}

	[data-state="offline"] .server-logo,
	[data-state="offline"] .server-name {
		opacity: 0;
	}

	[data-state="offline"] .server-offline {
		opacity: 1;
	}

	[data-state="offline"] .post-group {
		transform: translateY(70px);
		opacity: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.edge,
		.person,
		.label,
		.server-box,
		.server-logo,
		.server-name,
		.server-offline,
		.post-group {
			transition: none;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>(".centralized").forEach((diagram) => {
		const toggle = diagram.querySelector<HTMLButtonElement>("[data-toggle]")!;
		const statuses = diagram.querySelectorAll<HTMLElement>("[data-status]");

		toggle.addEventListener("click", () => {
			const offline = diagram.dataset.state !== "offline";
			diagram.dataset.state = offline ? "offline" : "online";
			toggle.setAttribute("aria-pressed", String(offline));
			toggle.textContent = offline ? "Bring Twitter back" : "Shut down Twitter";
			statuses.forEach((status) => {
				status.hidden = status.dataset.status !== diagram.dataset.state;
			});
		});
	});
</script>
